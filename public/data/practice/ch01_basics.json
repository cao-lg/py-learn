    {
      "id": "q09_time_convert",
      "type": "output",
      "title": "时间转换",
      "skill": "综合应用",
      "instruction": "将总秒数 `3723` 转换为 \"X小时Y分钟Z秒\" 格式并打印",
      "initialCode": "total_seconds = 3723\n# 在下方编写代码\n",
      "testCases": [
        { "name": "基础测试", "expected": "1小时2分钟3秒", "weight": 0.5 },
        { "name": "边界测试-仅秒", "input": "total_seconds = 45\nprint(f'{total_seconds}秒')", "expected": "45秒", "isHidden": true, "weight": 0.25 },
        { "name": "边界测试-仅分钟", "input": "total_seconds = 180\nprint('3分钟')", "expected": "3分钟", "isHidden": true, "weight": 0.25 }
      ],
      "testConfig": {
        "expected": "1小时2分钟3秒",
        "timeout_ms": 5000
      },
      "hints": [
        { "text": "小时 = total_seconds // 3600", "visible": true },
        { "text": "分钟 = (total_seconds % 3600) // 60", "visible": false }
      ],
      "difficulty": 3
    },
    {
      "id": "q10_bmi",
      "type": "output",
      "title": "BMI计算",
      "skill": "综合应用",
      "instruction": "计算 BMI 指数。已知体重 70kg，身高 1.75m。公式：BMI = 体重 / 身高²。打印结果保留1位小数。",
      "initialCode": "weight = 70\nheight = 1.75\n# 在下方编写代码\n",
      "testCases": [
        { "name": "基础测试", "expected": "22.9", "weight": 0.5 },
        { "name": "边界测试-正常BMI", "input": "weight = 60\nheight = 1.7\n# 计算BMI", "expected": "20.8", "isHidden": true, "weight": 0.25 },
        { "name": "边界测试-高BMI", "input": "weight = 100\nheight = 1.6\n# 计算BMI", "expected": "39.1", "isHidden": true, "weight": 0.25 }
      ],
      "testConfig": {
        "expected": "22.9",
        "timeout_ms": 5000
      },
      "hints": [
        { "text": "BMI = weight / (height ** 2)", "visible": true },
        { "text": "使用 round() 或 f-string 保留小数", "visible": false }
      ],
      "difficulty": 3
    }
