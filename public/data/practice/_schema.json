{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "type": {
      "enum": ["output", "function", "interactive", "unittest", "constraint", "debug"]
    },
    "title": { "type": "string" },
    "skill": { "type": "string" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 3 },
    "instruction": { "type": "string" },
    "initialCode": { "type": "string" },
    "testCases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "input": { "type": ["string", "array", "object", "null"] },
          "expected": { "type": ["string", "number", "boolean", "array", "object", "null"] },
          "isHidden": { "type": "boolean", "default": false },
          "weight": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "required": ["name", "expected"]
      },
      "minItems": 1
    },
    "testConfig": {
      "type": "object",
      "properties": {
        "expected": { "type": ["string", "null"] },
        "mockInputs": { "type": "array", "items": { "type": "string" } },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "timeout_ms": { "type": "integer", "minimum": 1000 },
        "constraints": { "type": "object" },
        "hiddenCases": { "type": "array" }
      },
      "required": ["timeout_ms"]
    },
    "hints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": { "type": "string" },
          "visible": { "type": "boolean" }
        }
      }
    }
  },
  "required": ["id", "type", "title", "skill", "instruction", "initialCode"]
}